# Copy to .env and adjust. Docker Compose reads this file automatically.

# --- Database ---
POSTGRES_USER=kafu
POSTGRES_PASSWORD=kafu
POSTGRES_DB=kafu
# Host port the Postgres container is published on
DB_PORT=5445

# --- App ---
# Host port the app container is published on
APP_PORT=3011

# Session encryption key. Generate one with: openssl rand -base64 32
# REQUIRED in production — never ship the default.
AUTH_SECRET=dev-only-secret-change-me

# Only needed when running the app outside Docker (npm run dev):
# DATABASE_URL=postgresql://kafu:kafu@localhost:5445/kafu

# Optional: extra origins allowed to reach the dev server, comma-separated.
# ALLOWED_DEV_ORIGINS=192.168.1.20,dev.local
